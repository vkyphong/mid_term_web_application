APP_PORT=8080
MYSQL_DATABASE=pulsechat
MYSQL_USER=pulsechat
# Run scripts/init-env.ps1 to generate local passwords and JWT_SECRET.
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_EMAIL_DOMAINS=DQGM.dev
# Same-origin LAN connections are accepted automatically. Extra origins are exact, comma separated.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
ACCESS_TTL_SECONDS=900
MYSQL_PORT=3307
