# Base URL của REST API. Để trống khi dev: Vite proxy /api -> VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3000

# Domain email được phép đăng ký (phân tách bằng dấu phẩy). Phải khớp cấu hình BE.
# FE chỉ kiểm tra để báo lỗi sớm; BE mới là nơi quyết định.
VITE_ALLOWED_EMAIL_DOMAINS=DQGM.dev

# true = dùng mock API trong trình duyệt (khi BE chưa sẵn sàng).
VITE_USE_MOCK_API=true
# TTL access token của mock (giây). Đặt nhỏ (vd 30) để demo luồng refresh.
VITE_MOCK_ACCESS_TTL_SECONDS=900
